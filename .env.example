# Host tools only; replace <DB_PASSWORD> with the value below.
DATABASE_URL=postgresql+psycopg://myuser:<DB_PASSWORD>@localhost:5432/mydb
# Compose credentials (required). Use hexadecimal passwords: no URL escaping needed.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
# An existing volume keeps the password it was created with; set this to that value.
DB_USER=myuser
DB_PASSWORD=
DB_NAME=mydb
APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_PORT=8025
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Redis password (required); Compose enables it on the redis service.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
REDIS_PASSWORD=
# Host tools only (Compose builds its own URL); replace REDIS_PASSWORD with the value above.
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
SMTP_STARTTLS=true
PUBLIC_APP_URL=http://localhost:8000
# Proxy peers whose X-Forwarded-For/X-Forwarded-Proto uvicorn trusts (read by uvicorn itself).
# Default 127.0.0.1. Behind a reverse proxy set this to the address that connects to the app
# container; otherwise all clients share the proxy IP for rate limits. Avoid '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
# Per endpoint, per socket IP and per account identifier where available.
RATE_LIMIT_PER_MINUTE=30
# Back up this directory together with the database. Compose uses a named volume.
MEDIA_ROOT=media
# Optional GitHub metadata collector: bounded shortlist, refreshed every six hours.
# Never add private repositories. Empty token uses GitHub's public API budget.
GITHUB_TOKEN=
GITHUB_REPOSITORIES=godotengine/godot,bevyengine/bevy,excalidraw/excalidraw,penpot/penpot,fastapi/fastapi,sveltejs/svelte,django/django,gdquest/learn-gdscript
# Optional GitLab.com public projects only; explicit allowlist, max 10, empty by default.
GITLAB_PROJECTS=
