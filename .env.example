DATABASE_URL=postgresql+psycopg://myuser:1234@localhost:5432/mydb
# Compose credentials. Use a long hexadecimal password (no URL-reserved characters).
# On an existing volume preserve its existing credentials.
DB_USER=myuser
DB_PASSWORD=1234
DB_NAME=mydb
APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_PORT=8025
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
SMTP_STARTTLS=true
PUBLIC_APP_URL=http://localhost:8000
# Per endpoint, per socket IP and per account identifier where available.
RATE_LIMIT_PER_MINUTE=30
# Back up this directory together with the database. Compose uses a named volume.
MEDIA_ROOT=media
