#!/usr/bin/env bash
# Run on the execution host. Writes a private PostgreSQL dump and photo archive; never prints secrets.
# Without --consistent, the dump and archive can capture writes made during the backup.
set -euo pipefail
umask 077
exec </dev/null
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
usage() {
    echo "Usage: ./scripts/backup [--consistent] [DIR]" >&2
    exit 2
}
consistent=false
if [[ "${1:-}" == "--consistent" ]]; then
    consistent=true
    shift
fi
if [[ "$#" -gt 1 || "${1:-}" == -* ]]; then
    usage
fi
base="${1:-backups}"
compose=(-f docker-compose.yml)
stopped=()
restart_services() {
    if [[ "${#stopped[@]}" -gt 0 ]]; then
        local services=("${stopped[@]}")
        stopped=()
        ./scripts/compose "${compose[@]}" start "${services[@]}"
    fi
}
trap restart_services EXIT
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="$base/$stamp"
mkdir -p -- "$base"
# mkdir fails if this second's backup already exists, so earlier files are never overwritten.
mkdir -m 700 -- "$target"
trap 'echo "Backup incomplete: $target; do not restore from it." >&2' ERR
if [[ "$consistent" == true ]]; then
    # Stop writers so the dump and photo archive describe one point in time.
    # Restart only what was running, so a stopped instance stays stopped.
    # Read state from the engine, not from exec: a failed exec (e.g. runtime error) looks like "stopped".
    # Engine choice mirrors scripts/compose. Any failure here aborts before the dump.
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        engine=docker
    else
        engine=podman
    fi
    container_ids="$(./scripts/compose "${compose[@]}" ps -q)"
    if [[ -n "$container_ids" ]]; then
        mapfile -t ids <<<"$container_ids"
        # Command substitution, not process substitution: a failing inspect must abort under set -e.
        states="$("$engine" inspect --format '{{index .Config.Labels "com.docker.compose.service"}} {{.State.Running}}' "${ids[@]}")"
        seen=0
        writers=()
        while read -r service running; do
            seen=$((seen + 1))
            if [[ "$running" != true && "$running" != false ]]; then
                echo "Cannot read state of service '$service': '$running'" >&2
                exit 1
            fi
            case "$service" in
            web | worker | beat)
                if [[ "$running" == true ]]; then
                    writers+=("$service")
                fi
                ;;
            esac
        done <<<"$states"
        # One line per container is expected; fewer lines would silently hide a running writer.
        if [[ "$seen" -ne "${#ids[@]}" ]]; then
            echo "Cannot read state of all containers: expected ${#ids[@]}, got $seen" >&2
            exit 1
        fi
        # Recorded only after validation, so the EXIT trap never starts a service this run did not stop.
        stopped+=("${writers[@]}")
    fi
    if [[ "${#stopped[@]}" -gt 0 ]]; then
        ./scripts/compose "${compose[@]}" stop "${stopped[@]}"
    fi
fi
# Variables are expanded inside the db container, where the credentials are set.
./scripts/compose "${compose[@]}" exec -T db sh -c \
    'exec pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' >"$target/db.dump"
# A one-off container reads the photo volume even while web is stopped.
./scripts/compose "${compose[@]}" run -T --rm --no-deps web tar -C /app/media -czf - . >"$target/media.tar.gz"
./scripts/compose "${compose[@]}" exec -T db pg_restore --list <"$target/db.dump" >/dev/null
tar -tzf "$target/media.tar.gz" >/dev/null
trap - ERR
echo "Backup verified: $target"
ls -lh -- "$target"
